<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Your Name" }}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="sidebar">
    <h1><a href="/">Your Name</a></h1>
    
    <div class="nav-group">
      <div class="nav-label">Selected Projects</div>
      <ul>
        {% for project in collections.projects %}
          <li>
            <a href="{{ project.url }}" {% if page.url == project.url %}class="active"{% endif %}>
              {{ project.data.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>

    <div class="nav-group">
      <ul>
        <li><a href="/writing/" {% if page.url == "/writing/" %}class="active"{% endif %}>Writing</a></li>
        <li><a href="/teaching/" {% if page.url == "/teaching/" %}class="active"{% endif %}>Teaching & Students</a></li>
      </ul>
    </div>
  </nav>

  <main class="content">
    {{ content | safe }}

    {# Automatically render all images if this is a project page #}
    {% if tags == "project" %}
      <div class="gallery">
        {% set images = page.inputPath | getProjectImages %}
        {% for img in images %}
          <img src="{{ img }}" alt="{{ title }}" loading="lazy">
        {% endfor %}
      </div>
    {% endif %}
  </main>
</body>
</html>
