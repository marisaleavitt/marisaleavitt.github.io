---
layout: base.njk
---

<div class="research-layout">

  <aside class="research-nav">
    <h2>Research</h2>

    {% for item in collections.research %}
      {% if item.url != "/research/" %}

      <div class="research-nav-item">
        <a href="{{ item.url }}">
          {{ item.data.title }}
        </a>
      </div>

      {% endif %}
    {% endfor %}
  </aside>

  <main class="research-content">
    {{ content | safe }}
  </main>

</div>
