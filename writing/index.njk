    <a href="/writing/{{ paper.pdf }}" target="_blank">
      <strong>{{ paper.title }}</strong>
    </a>

    <div class="bib-meta">
      {{ paper.publication }}, {{ paper.year }}
    </div>
  </div>
{% endfor %}
